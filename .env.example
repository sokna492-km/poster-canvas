# Optional API base URL for future backend integration.
# Wired through configureApp({ apiBaseUrl }).
VITE_API_BASE_URL=

# Base path for the app URL (default: /poster-canvas → http://localhost:5173/poster-canvas).
# Set to / for root deployment.
VITE_BASE_PATH=/poster-canvas

# Same Supabase project as KruMath (NEXT_PUBLIC_SUPABASE_* values).
# Required for production soft gate (Export / Add Logo).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: local KruMath web origin for sign-in / home redirects during development.
# Example: http://localhost:3000
# VITE_KRUMATH_ORIGIN=
